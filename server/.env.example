# Server environment configuration
# Copy this file to .env and fill in real values.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/testora

# Secrets - generate strong random values (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change_me_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
COOKIE_SECRET=change_me_cookie_secret_32_chars_min

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
MAX_FILE_SIZE_MB=20

# DECIDE_UPLOADS: use "cloudinary" or "local"
# Cloudinary (optional). Leave blank to fall back to local /tmp storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional OpenAI-compatible AI provider.
# DashScope example: https://<host>/compatible-mode/v1
# Never commit the real API key.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
